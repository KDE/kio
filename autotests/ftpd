require 'stringio'
require 'ftpd'
require 'logger'
require 'tmpdir'

STDOUT.sync = true

# Monkey patch the site handler, it's not implemented so fake it a bit for ftp
# worker purposes.

# FIXME: and yet I seee kio_ftp(8319)/(kf5.kio.kio_ftp) Ftp::ftpChmod: ftpChmod: CHMOD not supported - disabling

module Ftpd
  class CmdSite
    alias cmd_site_orig cmd_site
    def cmd_site(_argument)
      # We don't support chmod bugger off.
      reply '500 cmd_site.'
    end
  end
end

module Ftpd
  class CmdRest
    def cmd_rest(_argument)
      reply "350 cmd_rest."
    end
  end
end

module Ftpd
  class CmdStor
    alias cmd_stor_orig cmd_stor
    def cmd_stor(argument)
      if argument.include?('__badResume__')
        reply '550 out of quota'
      else
        cmd_stor_orig(argument)
      end
    end
  end
end

# Add some simulation capabilities to the file system
class MangledDiskFileSystem < Ftpd::DiskFileSystem
  def accessible?(path, *args)
    return false if path.include?('__inaccessiblePath__')

    super(path, *args)
  end
end

# Optional third argument: how the server answers directory listings.
#   list         - no MLST in FEAT, LIST only (default)
#   mlsd-bare    - MLSD with type, size and modify only
#   mlsd-perm    - MLSD with the RFC 3659 perm fact
#   mlsd-unix    - MLSD with perm and UNIX.mode; perm always claims write access, UNIX.mode is the real mode
#   mlsd-refused - MLST in FEAT but MLSD is an unknown command
#   mlsd-stall   - MLSD as mlsd-perm, but the data connection stops sending after the first line
MLSD_MODE = ARGV.fetch(2, 'list')

module Ftpd
  class CmdFeat
    alias extensions_orig extensions
    def extensions
      return extensions_orig if MLSD_MODE == 'list'

      extensions_orig + ['MLST type*;size*;modify*;perm*;UNIX.mode*']
    end
  end

  class CmdMlsd < CommandHandler
    def cmd_mlsd(argument)
      close_data_server_socket_when_done do
        # Closes the passive data socket first, as a server without MLSD would.
        unimplemented_error if MLSD_MODE == 'mlsd-refused'
        ensure_logged_in
        path = File.expand_path(argument || '.', name_prefix)
        ensure_accessible path
        ensure_exists path
        ensure_directory path
        # The cdir entry is named by its full path, as some servers do.
        lines = [mlsd_line(file_system.file_info(path), 'cdir', path),
                 mlsd_line(file_system.file_info(path), 'pdir', '..')]
        file_system.dir(File.join(path, '*')).sort.each do |child|
          info = file_system.file_info(child)
          lines << mlsd_line(info, info.directory? ? 'dir' : 'file', File.basename(child))
        end
        if MLSD_MODE == 'mlsd-stall'
          open_data_connection do |data_socket|
            data_socket.write(lines.first)
            data_socket.flush
            sleep(60)
            data_socket.write(lines.drop(1).join)
          end
          reply '226 Transfer complete'
        else
          transmit_file(StringIO.new(lines.join), 'A')
        end
      end
    end

    private

    def mlsd_line(info, type, name)
      dir = type != 'file'
      writable = MLSD_MODE == 'mlsd-unix' || (info.mode & 0o200) != 0
      facts = ["type=#{type}", "size=#{info.size}", "modify=#{info.mtime.utc.strftime('%Y%m%d%H%M%S')}"]
      if MLSD_MODE != 'mlsd-bare'
        rights = if dir
                   writable ? 'flcdmpe' : 'fle'
                 else
                   writable ? 'adfrw' : 'r'
                 end
        facts << "perm=#{rights}"
      end
      facts << format('UNIX.mode=0%o', info.mode & 0o777) if MLSD_MODE == 'mlsd-unix'
      "#{facts.join(';')}; #{name}\r\n"
    end
  end

  class CommandHandlerFactory
    class << self
      alias standard_command_handlers_orig standard_command_handlers
      def standard_command_handlers
        return standard_command_handlers_orig unless MLSD_MODE.start_with?('mlsd-')

        standard_command_handlers_orig + [CmdMlsd]
      end
    end
  end
end

class Driver
  def initialize(temp_dir)
    @temp_dir = temp_dir
  end

  def authenticate(_user, _password)
    true
  end

  def file_system(_user)
    MangledDiskFileSystem.new(@temp_dir)
  end
end

# NB: stderr is used to communicate with the parent!

port = ARGV.fetch(0)
temp_dir = File.expand_path(ARGV.fetch(1))

driver = Driver.new(temp_dir)
server = Ftpd::FtpServer.new(driver)
server.port = port
server.log = Logger.new($stdout)
server.start
warn "port = #{server.bound_port}"
puts "Server listening on port #{server.bound_port}"
loop do
  sleep(1)
end
