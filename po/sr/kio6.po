#: core/copyjob.cpp:196 kioworkers/file/file_unix.cpp:595
#, kde-format
msgctxt ""
"The first arg is the path to the symlink that couldn't be created, the "
"secondarg is the filesystem type (e.g. vfat, exfat)"
msgid ""
"Could not create symlink \"%1\".\n"
"The destination filesystem (%2) doesn't support symlinks."
msgstr ""
"Не могу да направим симболичку везу „%1“.\n"
"Одредишни фајл систем (%2) не подржава симболичке везе."

#: core/copyjob.cpp:208
#, kde-format
msgid ""
"Could not create \"%1\".\n"
"The destination filesystem (%2) disallows the following characters in folder "
"names: %3\n"
"Selecting Replace will replace any invalid characters (in the destination "
"folder name) with an underscore \"_\"."
msgstr ""
"Не могу да направим „%1“.\n"
"Одредишни фајл систем (%2) не дозвољава следеће знакове у именима фасцикли: "
"%3\n"
"Избором „Замени“ сви неисправни знакови (у имену одредишне фасцикле) биће "
"замењени подвлаком „_“."

#: core/copyjob.cpp:216
#, kde-format
msgid ""
"Could not create \"%1\".\n"
"The destination filesystem (%2) disallows the following characters in file "
"names: %3\n"
"Selecting Replace will replace any invalid characters (in the destination "
"file name) with an underscore \"_\"."
msgstr ""
"Не могу да направим „%1“.\n"
"Одредишни фајл систем (%2) не дозвољава следеће знакове у именима фајлова: "
"%3\n"
"Избором „Замени“ сви неисправни знакови (у имену одредишног фајла) биће "
"замењени подвлаком „_“."

