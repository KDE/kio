#: core/job_error.cpp:1232
#, kde-format
msgid ""
"The operation could not be completed because the source can not be moved "
"into itself."
msgstr ""
"Поступак није могао бити довршен зато што извор не може да се премести сам у "
"себе."

#: core/job_error.cpp:1234
#, kde-format
